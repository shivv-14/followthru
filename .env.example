# Copy to .env.local and fill in. Never commit .env.local.
# Browser-safe (Vite exposes VITE_* to the frontend). Supabase: Project Settings -> API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only: used by the API routes (npm run dev and Vercel functions). Never prefix with VITE_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Optional: force the browser-only demo mode even when Supabase is configured
# VITE_BACKEND=local
